{
  "name": "kyt-d1",
  "version": "0.12.0",
  "description": "Opinionated Cloudflare D1 + Kysely toolkit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kyt-d1": "dist/cli.js",
    "d1-kyt": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "echo noop",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "kysely",
    "sqlite",
    "workers",
    "valibot"
  ],
  "author": "sher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sher/kyt.git",
    "directory": "packages/kyt-d1"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0",
    "valibot": ">=1.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "kysely": "0.29.6",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.5"
  }
}
